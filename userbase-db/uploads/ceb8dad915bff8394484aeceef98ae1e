Write-Host "`n=== DNS Диагностика ===`n" -ForegroundColor Cyan

# 1. DNS-серверы, настроенные в системе (по интерфейсам)
Write-Host "[1] DNS-серверы, настроенные в системе (по интерфейсам):`n" -ForegroundColor Yellow
Get-DnsClientServerAddress | ForEach-Object {
    $alias = $_.InterfaceAlias
    $servers = if ($_.ServerAddresses) { $_.ServerAddresses -join ', ' } else { '(нет)' }
    Write-Host "$alias`t$servers"
}

# 2. Проверка, какой DNS отвечает (nslookup)
Write-Host "`n[2] Проверка, какой DNS отвечает (nslookup):`n" -ForegroundColor Yellow
$nslookup = nslookup google.com | Select-String "Server|Address"
$nslookup | ForEach-Object { $_.Line }

# 3. Resolve-DnsName IPv4/IPv6 для google.com
Write-Host "`n[3] Resolve-DnsName IPv4/IPv6 для google.com:`n" -ForegroundColor Yellow
Resolve-DnsName google.com | Format-Table -AutoSize

# 4. Пинг DNS-серверов
Write-Host "`n[4] Пинг DNS-серверов:`n" -ForegroundColor Yellow
$dnsServers = Get-DnsClientServerAddress | ForEach-Object { $_.ServerAddresses } | Where-Object { $_ }
if (-not $dnsServers) {
    Write-Host "DNS-серверы для пинга не найдены."
} else {
    foreach ($dns in $dnsServers) {
        Write-Host "Пингуем $dns..."
        $pingResults = Test-Connection -ComputerName $dns -Count 2 -ErrorAction SilentlyContinue
        if ($pingResults) {
            $pingResults | Select-Object Address, ResponseTime | Format-Table -AutoSize
        } else {
            Write-Host "Не удалось пинговать $dns"
        }
    }
}

# 5. Активный сетевой интерфейс (маршрут по умолчанию)
Write-Host "`n[5] Активный сетевой интерфейс (маршрут по умолчанию):`n" -ForegroundColor Yellow
$route = Get-NetRoute -DestinationPrefix "0.0.0.0/0" | Sort-Object -Property RouteMetric | Select-Object -First 1
if ($route) {
    Write-Host "Интерфейс: $($route.InterfaceAlias), Метрика маршрута: $($route.RouteMetric), NextHop: $($route.NextHop)"
} else {
    Write-Host "Информация о маршруте по умолчанию не найдена."
}

Write-Host "`n=== Проверка завершена ===`n" -ForegroundColor Cyan